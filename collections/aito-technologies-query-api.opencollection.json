          "docs": "Get status for a job"
        },
        {
          "info": {
            "name": "GET /api/v1/jobs/{uuid}/result",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://shared.aito.ai/api/v1/jobs/:uuid/result"
