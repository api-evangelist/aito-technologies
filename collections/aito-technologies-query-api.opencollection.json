{
  "opencollection": "1.0.0",
  "info": {
    "name": "Aito Technologies data query API"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "query",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "POST /api/v1/jobs/{query}",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://shared.aito.ai/api/v1/jobs/:query",
            "params": [
              {
                "name": "query",
                "value": "",
                "type": "path",
                "description": "Any of the Aito query endpoints"
              }
            ]
          },
          "docs": "Create a job for a query"
        },
        {
          "info": {
            "name": "GET /api/v1/jobs/",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://shared.aito.ai/api/v1/jobs/"
          },
          "docs": "Get status for all jobs"
        },
        {
          "info": {
            "name": "GET /api/v1/jobs/{uuid}",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://shared.aito.ai/api/v1/jobs/:uuid"
